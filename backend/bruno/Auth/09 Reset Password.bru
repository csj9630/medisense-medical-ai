meta {
  name: 09 Reset Password
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "여기에 dev_reset_url에서 복사한 token 값을 붙여넣으세요",
    "new_password": "newPassword1234"
  }
}

docs {
  토큰 하나는 한 번만 쓸 수 있습니다 — 재사용하려면 Forgot Password부터 다시.
}
